# 服务监听。生产环境建议仅监听内网地址，并由 HTTPS 反向代理转发。
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DB_PATH=./data/usage.db

# 每项都必须替换为独立随机值。
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_WITH_INDEPENDENT_RANDOM_SECRET
CONTROL_TOKEN_SECRET=CHANGE_ME_WITH_ANOTHER_RANDOM_SECRET
AUDIT_HASH_SECRET=CHANGE_ME_WITH_ANOTHER_RANDOM_SECRET

# 管理员初始凭据；密码至少 12 个字符。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# 必须为 32 字节随机密钥的 Base64 编码。
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_WITH_32_BYTE_BASE64

# 通过 HTTPS 反向代理访问时设为 true。
COOKIE_SECURE=true
TRUST_PROXY=1

# 外部请求安全策略。仅在受控内网联调时才考虑临时开启。
OUTBOUND_ALLOW_PRIVATE=false
OUTBOUND_ALLOW_HTTP=false

# 用量快照和公开控制配置。
SNAPSHOT_RETENTION_DAYS=30
REFRESH_CONCURRENCY=4
PUBLIC_ACTION_TOKEN_TTL_SECONDS=900
